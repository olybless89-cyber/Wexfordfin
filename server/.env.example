# Postgres connection string (Railway sets this automatically via a
# reference variable to the Postgres service, e.g. ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://user:password@host:5432/railway

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# Port to listen on. Railway sets this automatically; only needed locally.
PORT=8080
